<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= page.title ? page.title + ' | ' + config.title : config.title %></title>
  <meta name="description" content="<%= page.description || config.description %>"/>
  <meta name="author" content="<%= config.author %>"/>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Ubuntu+Mono:ital,wght@0,400;0,700;1,400&family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <link rel="shortcut icon" href="/img/WZTB.png">
  <link rel="stylesheet" href="/css/claude.css"/>
</head>
<body>

<!-- Noise texture overlay -->
<div class="noise-overlay"></div>

<!-- Navigation -->
<nav class="nav">
  <div class="nav__inner">
    <a class="nav__logo" href="/">
      <span class="nav__logo-dot"></span>
      <%= config.title %>
    </a>
    <div class="nav__links">
      <% if (theme.menu) { %>
        <% for (const [label, url] of Object.entries(theme.menu)) { %>
          <a href="<%= url %>" class="<%= (url === '/' && is_home()) || (url !== '/' && page.path && page.path.startsWith(url.replace(/^\//, ''))) ? 'active' : '' %>"><%= label %></a>
        <% } %>
      <% } %>
    </div>
    <div class="nav__actions">
      <button class="theme-toggle" id="themeToggle" aria-label="切换主题">
        <svg class="sun-icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <circle cx="8" cy="8" r="3.5" stroke="currentColor" stroke-width="1.3"/>
          <path d="M8 1V3M8 13V15M1 8H3M13 8H15M3.05 3.05L4.46 4.46M11.54 11.54L12.95 12.95M12.95 3.05L11.54 4.46M4.46 11.54L3.05 12.95" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
        <svg class="moon-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" style="display:none">
          <path d="M13.5 9.5C12.5 12 9.5 13.5 6.5 12.5C3.5 11.5 2 8.5 3 5.5C3.5 4 4.5 3 5.5 2.5C3 3.5 1.5 6.5 2.5 9.5C3.5 12.5 6.5 14 9.5 13C11 12.5 12.5 11 13.5 9.5Z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button class="menu-toggle" id="menuToggle" aria-label="菜单">
        <span class="menu-toggle__line"></span>
        <span class="menu-toggle__line"></span>
        <span class="menu-toggle__line"></span>
      </button>
    </div>
  </div>
  <!-- Mobile Menu Drawer -->
  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu__inner">
      <% if (theme.menu) { %>
        <% for (const [label, url] of Object.entries(theme.menu)) { %>
          <a href="<%= url %>" class="mobile-menu__link"><%= label %></a>
        <% } %>
      <% } %>
    </div>
  </div>
</nav>

<main class="main">
  <%- body %>
</main>

<!-- Footer -->
<footer class="footer">
  <div class="container">
    <div class="footer__inner">
      <div class="footer__brand">
        <div class="footer__logo">
          <span class="nav__logo-dot"></span> <%= config.title %>
        </div>
        <p><%= theme.home_description || '个人博客' %></p>
        <div class="footer__social">
          <% if (theme.social) { %>
            <% for (const [name, url] of Object.entries(theme.social)) { %>
              <a href="<%= url %>" target="_blank" rel="noopener"><%= name %></a>
            <% } %>
          <% } %>
        </div>
      </div>
      <div class="footer__col">
        <h4>导航</h4>
        <% if (theme.menu) { %>
          <% for (const [label, url] of Object.entries(theme.menu)) { %>
            <a href="<%= url %>"><%= label %></a>
          <% } %>
        <% } %>
      </div>
      <div class="footer__col">
        <h4>信息</h4>
        <a href="/archives/">归档 (<%= site.posts.length %>)</a>
      </div>
    </div>
    <div class="footer__bottom">
      &copy; <%= theme.footer_since || '2020' %> - <%= new Date().getFullYear() %> By <%= config.author %>
    </div>
  </div>
</footer>

<script src="/js/claude.js"></script>
</body>
</html>
