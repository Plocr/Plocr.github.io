<section class="archive-page">
  <div class="container">
    <div class="archive-layout">
      <!-- Left: Category Cards -->
      <div class="archive-categories">
        <header class="archive-categories__header">
          <h1 class="archive-categories__title">文章分类</h1>
        </header>
        <div class="archive-categories__grid">
          <a href="/tags/项目日志/" class="archive-card">
            <span class="archive-card__num">01</span>
            <span class="archive-card__title">项目日志</span>
            <span class="archive-card__count"><%= site.posts.filter(function(p) { return p.tags && p.tags.find(function(t) { return t.name === '项目日志'; }); }).length %> 篇</span>
          </a>
          <a href="/tags/工作流分享/" class="archive-card">
            <span class="archive-card__num">02</span>
            <span class="archive-card__title">工作流分享</span>
            <span class="archive-card__count"><%= site.posts.filter(function(p) { return p.tags && p.tags.find(function(t) { return t.name === '工作流分享'; }); }).length %> 篇</span>
          </a>
          <a href="/tags/随笔/" class="archive-card">
            <span class="archive-card__num">03</span>
            <span class="archive-card__title">说些乱七八糟的</span>
            <span class="archive-card__count"><%= site.posts.filter(function(p) { return p.tags && p.tags.find(function(t) { return t.name === '随笔'; }); }).length %> 篇</span>
          </a>
          <a href="/tags/影音推荐/" class="archive-card">
            <span class="archive-card__num">04</span>
            <span class="archive-card__title">影音推荐</span>
            <span class="archive-card__count"><%= site.posts.filter(function(p) { return p.tags && p.tags.find(function(t) { return t.name === '影音推荐'; }); }).length %> 篇</span>
          </a>
        </div>
      </div>

      <!-- Right: Timeline -->
      <div class="archive-timeline">
        <header class="archive-timeline__header">
          <h2 class="archive-timeline__title">时间轴</h2>
          <p class="archive-timeline__subtitle">共 <%= site.posts.length %> 篇文章</p>
        </header>
        <div class="timeline">
          <% if (site.posts && site.posts.length > 0) { %>
            <%
              var currentYear = '';
              site.posts.sort('date', -1).each(function(post) {
                var postYear = date(post.date, 'YYYY');
                if (postYear !== currentYear) {
                  currentYear = postYear;
            %>
              <div class="timeline-year"><%= postYear %></div>
            <% } %>
            <article class="timeline-item" onclick="window.location='<%= url_for(post.path) %>'">
              <div class="timeline-dot"></div>
              <time class="timeline-date" datetime="<%= date_xml(post.date) %>">
                <%= date(post.date, 'MM-DD') %>
              </time>
              <div class="timeline-content">
                <h3 class="timeline-title"><%= post.title %></h3>
                <% if (post.tags && post.tags.length > 0) { %>
                  <div class="timeline-tags">
                    <% post.tags.each(function(tag) { %>
                      <span class="tag"><%= tag.name %></span>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            </article>
          <% }) %>
        <% } else { %>
          <p class="empty-state">还没有文章</p>
        <% } %>
        </div>
      </div>
    </div>
  </div>
</section>
