<section class="archive-page">
  <div class="container">
    <header class="page-header">
      <h1 class="page-header__title">文章归档</h1>
      <p class="page-header__subtitle">共 <%= site.posts.length %> 篇文章</p>
    </header>

    <div class="archive-list">
      <% if (site.posts && site.posts.length > 0) { %>
        <%
          let currentYear = '';
          site.posts.sort('date', -1).each(function(post) {
            var postYear = date(post.date, 'YYYY');
            if (postYear !== currentYear) {
              currentYear = postYear;
        %>
          <div class="archive-year"><%= postYear %></div>
        <% } %>
        <article class="archive-item" onclick="window.location='<%= url_for(post.path) %>'">
          <time class="archive-item__date" datetime="<%= date_xml(post.date) %>">
            <%= date(post.date, 'MM-DD') %>
          </time>
          <h3 class="archive-item__title"><%= post.title %></h3>
        </article>
        <% }) %>
      <% } else { %>
        <p class="empty-state">还没有文章</p>
      <% } %>
    </div>
  </div>
</section>
