<!-- ===== Hero Section - Full Screen ===== -->
<section class="hero" id="hero">
  <!-- Floating particles background -->
  <div class="hero-particles">
    <div class="particle" style="top:15%;left:10%;width:12px;height:12px;animation-delay:0s"></div>
    <div class="particle" style="top:25%;right:15%;width:8px;height:8px;animation-delay:0.5s"></div>
    <div class="particle" style="bottom:35%;left:20%;width:10px;height:10px;animation-delay:1s"></div>
    <div class="particle" style="top:40%;right:25%;width:6px;height:6px;animation-delay:1.5s"></div>
    <div class="particle" style="bottom:20%;left:5%;width:14px;height:14px;animation-delay:2s"></div>
    <div class="particle" style="top:60%;right:10%;width:9px;height:9px;animation-delay:2.5s"></div>
    <div class="particle" style="bottom:45%;left:35%;width:7px;height:7px;animation-delay:3s"></div>
    <div class="particle" style="top:10%;right:35%;width:11px;height:11px;animation-delay:3.5s"></div>
  </div>

  <div class="hero__inner">
    <div class="hero__content">
      <h1 class="hero__title" id="hero-title">
        <span class="hero__title-line"><%= theme.home_title || config.title %></span>
      </h1>
      <p class="hero__description"><%= theme.home_description || '个人博客，记录技术与生活的点滴' %></p>

      <div class="hero__social">
        <% if (theme.social) { %>
          <% for (const [name, url] of Object.entries(theme.social)) { %>
            <a href="<%= url %>" target="_blank" rel="noopener" class="hero__social-link"><%= name %></a>
          <% } %>
        <% } %>
      </div>

      <div class="hero__actions">
        <a class="btn btn--primary" href="/archives/">
          浏览文章
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M5 2L10 7L5 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a class="btn btn--outline" href="/about/">关于我</a>
      </div>
    </div>
    <div class="hero__illustration" id="hero-illustration"></div>
  </div>

  <!-- Scroll down indicator -->
  <div class="hero__scroll" id="scrollIndicator">
    <span class="hero__scroll-text">向下滚动</span>
    <div class="hero__scroll-arrow">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
        <path d="M3 6L9 12L15 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>
</section>

<!-- ===== Recent Posts ===== -->
<section class="section featured reveal">
  <div class="container">
    <div class="section__header reveal-item">
      <span class="section-label">最新文章</span>
      <h2 class="section__title">最近更新</h2>
    </div>
    <% if (site.posts && site.posts.length > 0) { %>
      <div class="posts-grid">
        <% site.posts.sort('date', -1).each(function(post) { %>
          <article class="post-card reveal-item" onclick="window.location='<%= url_for(post.path) %>'">
              <div class="post-card__thumb">
                <%
                  // Try to extract first image from post content
                  var firstImg = '';
                  if (post.content) {
                    var imgMatch = post.content.match(/<img\s+[^>]*src=["']([^"']+)["']/i);
                    if (imgMatch) firstImg = imgMatch[1];
                  }
                %>
                <% if (firstImg) { %>
                  <img src="<%= firstImg %>" alt="<%= post.title %>" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
                  <div class="post-card__cover-placeholder" data-title="<%= post.title %>" data-index="<%= post.__index || post._id || Math.floor(Math.random() * 1000) %>" style="display:none"></div>
                <% } else { %>
                  <div class="post-card__cover-placeholder" data-title="<%= post.title %>" data-index="<%= post.__index || post._id || Math.floor(Math.random() * 1000) %>"></div>
                <% } %>
              </div>
            <div class="post-card__body">
              <div class="post-card__meta">
                <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
              </div>
              <h2 class="post-card__title"><%= post.title %></h2>
              <% if (post.excerpt) { %>
                <p class="post-card__excerpt"><%= strip_html(post.excerpt).substring(0, 120) %></p>
              <% } %>
              <div class="post-card__tags">
                <% if (post.tags && post.tags.length > 0) { %>
                  <% post.tags.each(function(tag) { %>
                    <span class="tag"><%= tag.name %></span>
                  <% }) %>
                <% } %>
              </div>
              <span class="post-card__readmore">阅读全文 →</span>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <p class="empty-state">还没有文章</p>
    <% } %>
  </div>
</section>

<%
  // Compute stats
  var totalWords = 0;
  var siteCreated = new Date('2023-05-09');
  var daysRunning = Math.floor((new Date() - siteCreated) / 86400000);
  site.posts.each(function(post) {
    if (post.content) totalWords += strip_html(post.content).length;
  });
  // Collect all tags with counts
  var tagCounts = {};
  site.posts.each(function(post) {
    if (post.tags) post.tags.each(function(t) {
      tagCounts[t.name] = (tagCounts[t.name] || 0) + 1;
    });
  });
  var tagNames = Object.keys(tagCounts);
%>

<!-- ===== Stats Cards ===== -->
<section class="section stats-cards reveal">
  <div class="container">
    <div class="stats-cards__grid">
      <div class="stat-card reveal-item">
        <span class="stat-card__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg></span>
        <span class="stat-card__value"><%= site.posts.length %></span>
        <span class="stat-card__label">篇文章</span>
      </div>
      <div class="stat-card reveal-item">
        <span class="stat-card__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/><path d="M12 18v-6"/><path d="M9 15h6"/></svg></span>
        <span class="stat-card__value"><%= totalWords.toLocaleString() %></span>
        <span class="stat-card__label">总字数</span>
      </div>
      <div class="stat-card reveal-item">
        <span class="stat-card__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
        <span class="stat-card__value"><%= daysRunning %></span>
        <span class="stat-card__label">运行天数</span>
      </div>
      <div class="stat-card reveal-item">
        <span class="stat-card__icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><path d="M7 7h.01"/></svg></span>
        <span class="stat-card__value"><%= tagNames.length %></span>
        <span class="stat-card__label">标签数</span>
      </div>
    </div>
  </div>
</section>

<!-- ===== Tags Cloud ===== -->
<% if (tagNames.length > 0) { %>
<section class="section tags-cloud reveal">
  <div class="container">
    <div class="section__header reveal-item">
      <span class="section-label">标签</span>
      <h2 class="section__title">标签云</h2>
    </div>
    <div class="tags-cloud__inner reveal-item">
      <% tagNames.sort().forEach(function(tag) { %>
        <% var count = tagCounts[tag]; %>
        <% var size = Math.min(5, Math.max(1, Math.ceil(count / 2))); %>
        <a href="/tags/<%= tag.toLowerCase().replace(/\s+/g, '-') %>/" class="tag-cloud-item" style="--tag-size: <%= size %>;"><%= tag %><sup><%= count %></sup></a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

