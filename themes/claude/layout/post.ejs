<article class="post-article">
  <div class="container">
    <div class="post-article__back">
      <a href="/archives/">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M9 2L4 7L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        返回文章列表
      </a>
    </div>

    <header class="post-article__header">
      <h1 class="post-article__title"><%= page.title %></h1>
      <div class="post-article__meta">
        <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
        <% if (page.updated && page.updated > page.date) { %>
          <span class="meta-sep">·</span>
          <span>更新于 <%= date(page.updated, 'YYYY-MM-DD') %></span>
        <% } %>
        <span class="meta-sep">·</span>
        <span><i class="far fa-eye"></i> <span id="busuanzi_value_page_pv"></span> 阅读</span>
      </div>
    </header>

    <% if (page.tags && page.tags.length > 0) { %>
      <div class="post-article__tags">
        <% page.tags.each(function(tag) { %>
          <span class="tag"><%= tag.name %></span>
        <% }) %>
      </div>
    <% } %>

    <div class="post-article__body">
      <%- page.content %>
    </div>

    <nav class="post-article__nav">
      <div class="post-nav__prev">
        <% if (page.prev) { %>
          <a href="<%= url_for(page.prev.path) %>">
            <span class="post-nav__label">← 上一篇</span>
            <span class="post-nav__title"><%= page.prev.title %></span>
          </a>
        <% } %>
      </div>
      <div class="post-nav__next">
        <% if (page.next) { %>
          <a href="<%= url_for(page.next.path) %>">
            <span class="post-nav__label">下一篇 →</span>
            <span class="post-nav__title"><%= page.next.title %></span>
          </a>
        <% } %>
      </div>
    </nav>

    <!-- Giscus Comments -->
    <div class="post-comments" id="post-comments">
      <div class="giscus"
        data-repo="Plocr/Plocr.github.io"
        data-repo-id="R_kgDOJgG_Zg"
        data-category="Announcements"
        data-category-id="DIC_kwDOJgG_Zs4C8wYj"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="https://www.plocr.online/css/giscus-light.css"
        data-lang="zh-CN"
        crossorigin="anonymous"
        async>
      </div>
      <script src="https://giscus.app/client.js"
        data-repo="Plocr/Plocr.github.io"
        data-repo-id="R_kgDOJgG_Zg"
        data-category="Announcements"
        data-category-id="DIC_kwDOJgG_Zs4C8wYj"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="https://www.plocr.online/css/giscus-light.css"
        data-lang="zh-CN"
        crossorigin="anonymous"
        async>
      </script>
      <noscript>请启用 JavaScript 来查看评论。</noscript>
    </div>
  </div>
</article>
